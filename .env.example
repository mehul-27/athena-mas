# Copy this file to .env and fill in the values. Never commit .env.
# The app loads .env from the repository root (python-dotenv).

# --- LLM provider ---------------------------------------------------------
# LiteLLM-style model string: "<provider>/<model-id>".
# Examples:
#   groq/qwen/qwen3.8-27b
#   deepseek/deepseek-chat
#   openai/gpt-4o-mini
#   openrouter/anthropic/claude-3.5-sonnet
LLM_MODEL=groq/qwen/qwen3.8-27b

# API key for the provider named in LLM_MODEL. Leave blank to use replay mode.
LLM_API_KEY=

# Optional OpenAI-compatible base URL. Use the API root (usually ending in /v1),
# not a /chat/completions path.
# LLM_API_BASE=http://localhost:8000/v1

# Some providers require a specific key variable (GROQ_API_KEY, DEEPSEEK_API_KEY,
# OPENAI_API_KEY, ...). The app mirrors LLM_API_KEY into the provider's variable.

# Reasoning models spend hidden tokens before visible output.
# low | medium | high. Empty means "do not send the parameter".
LLM_REASONING_EFFORT=

# Fallback output cap for calls not tied to a role.
LLM_MAX_TOKENS=512

# Per-role output budgets (critic needs room for a structured critique).
# planner 1500 | researcher 2000 | analyst 3000 | writer 3000 | critic 3000
# LLM_MAX_TOKENS_PLANNER=1500
# LLM_MAX_TOKENS_RESEARCHER=2000
# LLM_MAX_TOKENS_ANALYST=3000
# LLM_MAX_TOKENS_WRITER=3000
# LLM_MAX_TOKENS_CRITIC=3000

# --- Interactive Chat ------------------------------------------------------
# Chat is separate from research: a direct streaming LLM call with optional
# grounding and selected tools.
# CHAT_DB=data/chat.db
# ATHENA_CHAT_MAX_TOKENS=3000
# ATHENA_CHAT_MAX_ROUNDS=4
# ATHENA_CHAT_MAX_TOOL_CALLS=8
# ATHENA_CHAT_TOOL_TIMEOUT_S=30
# ATHENA_CHAT_HISTORY_TURNS=20
# ATHENA_CHAT_HISTORY_CHARS=12000
# ATHENA_CHAT_MAX_MESSAGE_CHARS=8000
# Relevance floor for chat RAG passages (hybrid score, 0-1).
# CHAT_RAG_MIN_SCORE=0.25

# --- Run limits and resilience -------------------------------------------
# Optional fixed gap between pipeline stages (seconds). Usually 0: the shared
# token limiter below does the pacing.
ATHENA_STAGE_PAUSE=0

# Hierarchical pattern: writer/research revision cycles after a high rejection.
ATHENA_MAX_REVISIONS=1

# Hard cap on model calls per pipeline run.
ATHENA_MAX_LLM_CALLS=12

# General worker caps; the researcher has a larger allowance because it gathers
# evidence. The demo API runs the CLI in a subprocess, so these apply per run.
ATHENA_MAX_TOOL_CALLS=3
ATHENA_WORKER_MAX_MODEL_CALLS=6
ATHENA_RESEARCHER_MAX_TOOL_CALLS=8
ATHENA_RESEARCHER_MAX_MODEL_CALLS=10
# Calculation is meant to answer one numeric request, not explore; keep it tighter.
ATHENA_CALC_MAX_TOOL_CALLS=4
ATHENA_CALC_MAX_MODEL_CALLS=4

# Cross-process SQLite-backed rate limiter (input/output tokens per minute).
# Set either to 0 to disable that limit. Defaults match a small hosted tier.
LLM_ITPM_LIMIT=7000
LLM_OTPM_LIMIT=1000
LLM_RATELIMIT_MAX_WAIT_S=120

# Timeouts for provider calls and A2A calls.
# ATHENA_LLM_TIMEOUT_S=120
# ATHENA_A2A_TIMEOUT_S=180

# --- Search and page fetching --------------------------------------------
# duckduckgo (keyless, can throttle) | searxng | disabled
SEARCH_PROVIDER=duckduckgo
# SearXNG base URL. Used when SEARCH_PROVIDER=searxng, and it is also the whole
# opt-in for the optional DuckDuckGo fallback (see below). The adapter appends
# /search and asks for the JSON API (format=json), so the instance must allow it.
# A trailing slash and a trailing /search are both tolerated.
# ATHENA_SEARXNG_URL=http://127.0.0.1:8080
# Legacy alias for ATHENA_SEARXNG_URL; still honoured, kept for old profiles.
# SEARXNG_INSTANCE=http://127.0.0.1:8080
# Optional fallback when the primary provider is throttled, unavailable or
# returns nothing. SearXNG is the only fallback: setting ATHENA_SEARXNG_URL
# enables it implicitly, or state it explicitly here. Setting this to "none"
# turns the fallback off even when ATHENA_SEARXNG_URL is present.
# SEARCH_FALLBACK_PROVIDER=searxng
# Takes precedence over ATHENA_SEARXNG_URL for the fallback only.
# SEARCH_FALLBACK_ENDPOINT=http://127.0.0.1:8080
# Cooldown after a provider throttles, in seconds (scoped per provider+query).
# SEARCH_THROTTLE_COOLDOWN=60
# Provider diagnostics (never prints secrets):
#   python -m athena.tools.diagnostics [--probe]

SEARCH_TIMEOUT=15
WEB_FETCH_TIMEOUT=12
WEB_FETCH_TOTAL_TIMEOUT=20
WEB_FETCH_MAX_BYTES=1000000
WEB_FETCH_MAX_CHARS=8000
# WEB_FETCH_USER_AGENT=AthenaResearchBot/1.0

# --- RAG / local corpus ---------------------------------------------------
# fastembed downloads a model on first use. Use hashing for a fully offline
# index with no model download (lower retrieval quality).
EMBEDDING_PROVIDER=fastembed
CORPUS_DIR=data/corpus
CHROMA_PATH=data/chroma
RAG_COLLECTION=athena_documents
# Targeted adjacent-chunk expansion for retrieval sets of 3+; 0 disables it.
RAG_ADJACENT_CHUNKS=1
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# --- Storage and observability -------------------------------------------
# Relative paths resolve from the repository root.
BLACKBOARD_DB=data/blackboard.db
EVENTS_DB=data/events.db
# ATHENA_REPLAY_DIR=data/demo/replay
# ATHENA_DATA_DIR=data
# ATHENA_MONITORING=1
# ATHENA_P2P_CONTEXT_CHARS=12000
