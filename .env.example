# Copy this file to .env and fill in the values. Never commit .env.

# LiteLLM-style model string: "<provider>/<model-id>".
# Examples: groq/qwen/qwen3.8-27b, deepseek/deepseek-chat, openai/gpt-4o-mini
LLM_MODEL=groq/qwen/qwen3.8-27b

# API key for the provider named in LLM_MODEL.
LLM_API_KEY=

# Optional base URL for an OpenAI-compatible endpoint.
# LLM_API_BASE=http://localhost:8000/v1

# Reasoning models spend hidden "reasoning" tokens out of the output budget.
# low | medium | high. Empty means "do not send the parameter".
LLM_REASONING_EFFORT=

# Fallback output cap for calls that are not tied to a role.
LLM_MAX_TOKENS=512

# Per-role output budgets. Reasoning models burn tokens before they emit any
# visible text, so these are deliberately generous. Override one role with the
# variable named after it; the value wins over the built-in default.
#   planner 1500 | researcher 2000 | analyst 1500 | writer 3000 | critic 1500
# LLM_MAX_TOKENS_PLANNER=1500
# LLM_MAX_TOKENS_RESEARCHER=2000
# LLM_MAX_TOKENS_ANALYST=1500
# LLM_MAX_TOKENS_WRITER=3000
# LLM_MAX_TOKENS_CRITIC=1500

# Optional fixed gap between pipeline stages (seconds). The shared token limiter
# below does the pacing now, so this stays 0; it is only a fallback for providers
# without a token meter.
ATHENA_STAGE_PAUSE=0
# --- Shared rate limiter (browser-free, cross-process, SQLite-backed) --------
# Input tokens per minute for the provider account. 0 disables the limiter.
# Groq free tier: 7000 ITPM, 1000 OTPM, 200000 TPD.
LLM_ITPM_LIMIT=7000
LLM_OTPM_LIMIT=1000
# How long one call may wait for room before it gives up with a clear error.
LLM_RATELIMIT_MAX_WAIT_S=120
# Hierarchical pattern: how many writer revisions a rejected critique may trigger.
ATHENA_MAX_REVISIONS=1
# Hard cap on tool calls per researcher run (each round-trip is re-sent).
ATHENA_MAX_TOOL_CALLS=3
# Hard cap on model calls per pipeline run (stops a model that loops on tools).
ATHENA_MAX_LLM_CALLS=12
