# Copy this file to .env and fill in the values. Never commit .env.

# LiteLLM-style model string: "<provider>/<model-id>".
# Examples: groq/qwen/qwen3.8-27b, deepseek/deepseek-chat, openai/gpt-4o-mini
LLM_MODEL=groq/qwen/qwen3.8-27b

# API key for the provider named in LLM_MODEL.
LLM_API_KEY=

# Optional output cap. Free tiers often meter output tokens per minute and
# reject the provider default; keep this low until you know your limit.
LLM_MAX_TOKENS=512

# Optional fixed gap between pipeline stages (seconds). The shared token limiter
# below does the pacing now, so this stays 0; it is only a fallback for providers
# without a token meter.
ATHENA_STAGE_PAUSE=0
# --- Shared rate limiter (browser-free, cross-process, SQLite-backed) --------
# Input tokens per minute for the provider account. 0 disables the limiter.
# Groq free tier: 7000 ITPM, 1000 OTPM, 200000 TPD.
LLM_ITPM_LIMIT=7000
LLM_OTPM_LIMIT=1000
# How long one call may wait for room before it gives up with a clear error.
LLM_RATELIMIT_MAX_WAIT_S=120
# Hierarchical pattern: how many writer revisions a rejected critique may trigger.
ATHENA_MAX_REVISIONS=1
# Hard cap on tool calls per researcher run (each round-trip is re-sent).
ATHENA_MAX_TOOL_CALLS=3