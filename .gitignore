# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.test-tmp/
.pytest-tmp/
pytest-cache-files-*/
.mypy_cache/

# Virtual environment
.venv/

# Secrets
.env

# Local scratch
.tmp/
.run/
.uv-cache/
.crewai/
.acl-recovery/
install.log
*.log

# Data: the corpus, vector index and model cache stay local.
# The evaluation CSVs are small and versioned, so they are re-included.
data/*
!data/.gitkeep
!data/eval/
!data/eval/*.csv
# Stray zero-byte file the CrewAI package creates in the CWD on some runs.
/crewai
# The demo ships its recorded runs and curated questions (public handbook data).
!data/demo/
!data/demo/questions.json
!data/demo/replay/
!data/demo/replay/*.json
# Local settings: the vault key and the encrypted secret store are never committed.
data/settings/master.key
data/settings/secrets.enc.json
data/settings/active_profile.jsondata/settings/profiles.json